# Optional: prefill API keys at build time.
# If set, these are written to localStorage on first load and the
# Settings modal won't auto-open. Users can still change them via the
# Settings button (the new value will be saved to localStorage and used
# until the env var changes on the next rebuild).
#
# Copy this file to .env.local and fill in your keys, then `npm run dev`.

VITE_ANTHROPIC_KEY=
VITE_APIFY_KEY=
